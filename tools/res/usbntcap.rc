#include <windows.h>
#include "usbntcap.h"

1 ICON "usbcam.ico"

IDD_FORMAT DIALOG 20, 20, 200, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "USBNT Camera - Picture Format"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Picture size and the camera's format:", -1, 8, 6, 184, 10
    LISTBOX         IDC_LIST, 8, 18, 184, 90, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Deliver 24 bit RGB (decoded)", IDC_RGB, 8, 112, 184, 10
    DEFPUSHBUTTON   "OK", IDOK, 88, 130, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 142, 130, 50, 14
END

IDD_SOURCE DIALOG 20, 20, 220, 130
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "USBNT Camera - Video Source"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Camera:", -1, 8, 8, 40, 10
    COMBOBOX        IDC_CAMERA, 50, 6, 162, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Brightness", -1, 8, 28, 50, 10
    SCROLLBAR       IDC_BRIGHT, 60, 27, 152, 10, WS_TABSTOP
    LTEXT           "Contrast", -1, 8, 44, 50, 10
    SCROLLBAR       IDC_CONTRAST, 60, 43, 152, 10, WS_TABSTOP
    LTEXT           "Saturation", -1, 8, 60, 50, 10
    SCROLLBAR       IDC_SAT, 60, 59, 152, 10, WS_TABSTOP
    LTEXT           "Gain", -1, 8, 76, 50, 10
    SCROLLBAR       IDC_GAIN, 60, 75, 152, 10, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 108, 108, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 108, 50, 14
END
