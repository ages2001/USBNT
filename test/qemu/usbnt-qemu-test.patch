+        uint32_t ptr2 = sitd.bufptr[1] & SITD_BUFPTR_MASK;
+        USBDevice *dev = ehci_find_device(ehci, devaddr);
+        USBEndpoint *ep;
+        uint32_t pid = dir ? USB_TOKEN_IN : USB_TOKEN_OUT;
+
+        ehci->periodic_sched_active = PERIODIC_ACTIVE;
+        if (len > 1023) {
+            len = 1023;
+        }
+        qemu_sglist_init(&ehci->isgl, ehci->device, 2, ehci->as);
+        if (off + len > 4096) {
+            qemu_sglist_add(&ehci->isgl, ptr1 + off, 4096 - off);
+            qemu_sglist_add(&ehci->isgl, ptr2, off + len - 4096);
+        } else if (len) {
+            qemu_sglist_add(&ehci->isgl, ptr1 + off, len);
+        }
+        ehci->ipacket.actual_length = 0;
+        ep = dev ? usb_ep_get(dev, pid, endp) : NULL;
+        if (ep && ep->type == USB_ENDPOINT_XFER_ISOC) {
+            usb_packet_setup(&ehci->ipacket, pid, ep, 0, entry, false,
+                             (sitd.results & SITD_RESULTS_IOC) != 0);
+            if (usb_packet_map(&ehci->ipacket, &ehci->isgl) == 0) {
+                usb_handle_packet(dev, &ehci->ipacket);
+                usb_packet_unmap(&ehci->ipacket, &ehci->isgl);
+            }
+        } else {
+            ehci->ipacket.status = USB_RET_NODEV;
+        }
+        qemu_sglist_destroy(&ehci->isgl);
+        if (ehci->ipacket.status != USB_RET_SUCCESS &&
+            ehci->ipacket.status != USB_RET_NAK) {
+            sitd.results |= SITD_RESULTS_XACTERR;
+            ehci_raise_irq(ehci, USBSTS_ERRINT);
+        }
+        sitd.results = (sitd.results & ~SITD_RESULTS_TBYTES_MASK) |
+                       (((len - ehci->ipacket.actual_length) << 16) & SITD_RESULTS_TBYTES_MASK);
+        sitd.results &= ~SITD_RESULTS_ACTIVE;
+        if (sitd.results & SITD_RESULTS_IOC) {
+            ehci_raise_irq(ehci, USBSTS_INT);
+        }
+        put_dwords(ehci, NLPTR_GET(entry), (uint32_t *)&sitd,
+                   sizeof(EHCIsitd) >> 2);
     }
 
     ehci_set_fetch_addr(ehci, async, sitd.next);
