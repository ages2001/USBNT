diff --git a/hw/usb/dev-rtsx-usb.c b/hw/usb/dev-rtsx-usb.c
new file mode 100644
index 0000000..75ab7e9
--- /dev/null
+++ b/hw/usb/dev-rtsx-usb.c
@@ -0,0 +1,390 @@
+/*
+ * Realtek USB card reader with the vendor protocol (RTS5129 "USB2.0-CRW"
+ * 0BDA:0129, RTS5139, RTS5179) - test model for the USBNT rtsxusb driver.
+ *
+ *   -device usb-rtsx,id=crw[,pid=0x0129][,lqfp=on]
+ *   -drive if=none,id=c,file=card.img,format=raw -device sd-card,drive=c,bus=crw.0
+ *
+ * Bulk OUT 2 takes "RTCR" packets: batch register commands (read, write,
+ * check; the reads and checks answer on bulk IN 1), sequential register
+ * reads / writes (the ping-pong buffer).  A batch with a data stage moves
+ * ring buffer data on the bulk pipes; the batch continues (and answers)
+ * after the data.  Control requests (vendor, 0) write single registers.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/qdev-properties.h"
+#include "hw/usb.h"
+#include "desc.h"
+#include "qom/object.h"
+#include "rtsx-engine.h"
+
+#define TYPE_USB_RTSX "usb-rtsx"
+OBJECT_DECLARE_SIMPLE_TYPE(USBRtsxState, USB_RTSX)
+
+#define R(a)            (0xC000 | ((a) & 0x3FFF))
+#define U_CARD_EXIST    0xFD6F
+#define U_OCPSTAT       0xFD83
+#define U_HW_VERSION    0xFC01
+#define U_CFG_MODE      0xFC0E
+#define U_CFG_MODE_1    0xFC0F
+#define U_CARD_SHARE    0xFD51
+#define U_DATA_SOURCE   0xFD5D
+#define U_CARD_STOP     0xFD53
+#define U_MC_DMA_TC0    0xFF11
+
+enum { ST_IDLE, ST_DATA_IN, ST_DATA_OUT };
+
+struct USBRtsxState {
+    USBDevice dev;
+    RtsxEngine e;
+    SDBus sdbus;
+    uint16_t pid;
+    bool lqfp;
+    /* current batch */
+    uint8_t cmd[1024];
+    uint32_t ncmd, next;
+    uint8_t flag;
+    int state;
+    uint32_t data_len, data_pos;
+    uint8_t *wbuf;
+    /* answer */
+    uint8_t rsp[1024];
+    uint32_t rsp_len;
+    bool rsp_ready;
+    uint32_t batches, bad;
+    /* command packet being received (full speed: several 64 byte packets) */
+    uint8_t obuf[1100];
+    uint32_t olen;
+};
+
+enum { STR_MANUFACTURER = 1, STR_PRODUCT, STR_SERIAL };
+
+static const USBDescStrings desc_strings = {
+    [STR_MANUFACTURER] = "Generic",
+    [STR_PRODUCT]      = "USB2.0-CRW",
+    [STR_SERIAL]       = "20071114173400000",
+};
+
+static const USBDescIface desc_iface_full = {
+    .bInterfaceNumber = 0, .bNumEndpoints = 3,
+    .bInterfaceClass = 0xFF, .bInterfaceSubClass = 0x06, .bInterfaceProtocol = 0x50,
+    .eps = (USBDescEndpoint[]) {
+        { .bEndpointAddress = USB_DIR_IN | 0x01, .bmAttributes = USB_ENDPOINT_XFER_BULK, .wMaxPacketSize = 64 },
+        { .bEndpointAddress = USB_DIR_OUT | 0x02, .bmAttributes = USB_ENDPOINT_XFER_BULK, .wMaxPacketSize = 64 },
+        { .bEndpointAddress = USB_DIR_IN | 0x03, .bmAttributes = USB_ENDPOINT_XFER_INT, .wMaxPacketSize = 2,
+          .bInterval = 10 },
+    }
+};
+
+static const USBDescIface desc_iface_high = {
+    .bInterfaceNumber = 0, .bNumEndpoints = 3,
+    .bInterfaceClass = 0xFF, .bInterfaceSubClass = 0x06, .bInterfaceProtocol = 0x50,
+    .eps = (USBDescEndpoint[]) {
+        { .bEndpointAddress = USB_DIR_IN | 0x01, .bmAttributes = USB_ENDPOINT_XFER_BULK, .wMaxPacketSize = 512 },
+        { .bEndpointAddress = USB_DIR_OUT | 0x02, .bmAttributes = USB_ENDPOINT_XFER_BULK, .wMaxPacketSize = 512 },
+        { .bEndpointAddress = USB_DIR_IN | 0x03, .bmAttributes = USB_ENDPOINT_XFER_INT, .wMaxPacketSize = 2,
+          .bInterval = 7 },
+    }
+};
+
+static const USBDescDevice desc_device_full = {
+    .bcdUSB = 0x0200, .bMaxPacketSize0 = 64, .bNumConfigurations = 1,
+    .confs = (USBDescConfig[]) {
+        { .bNumInterfaces = 1, .bConfigurationValue = 1, .bmAttributes = USB_CFG_ATT_ONE, .bMaxPower = 250,
+          .nif = 1, .ifs = &desc_iface_full },
+    },
+};
+
+static const USBDescDevice desc_device_high = {
+    .bcdUSB = 0x0200, .bMaxPacketSize0 = 64, .bNumConfigurations = 1,
+    .confs = (USBDescConfig[]) {
+        { .bNumInterfaces = 1, .bConfigurationValue = 1, .bmAttributes = USB_CFG_ATT_ONE, .bMaxPower = 250,
+          .nif = 1, .ifs = &desc_iface_high },
+    },
+};
+
+static USBDesc desc_rtsx = {
+    .id = {
+        .idVendor = 0x0BDA, .idProduct = 0x0129, .bcdDevice = 0x3960,
+        .iManufacturer = STR_MANUFACTURER, .iProduct = STR_PRODUCT, .iSerialNumber = STR_SERIAL,
+    },
+    .full = &desc_device_full,
+    .high = &desc_device_high,
+    .str = desc_strings,
+};
+
+static void rtsx_live_regs(USBRtsxState *s)
+{
+    RtsxEngine *e = &s->e;
+    bool in = sdbus_get_inserted(&s->sdbus);
+
+    e->regs[R(U_CARD_EXIST)] = (in ? 0x04 : 0) | (in && sdbus_get_readonly(&s->sdbus) ? 0x20 : 0);
+    e->regs[R(U_OCPSTAT)] = 0;
+}
+
+static void rsp_put(USBRtsxState *s, uint8_t v)
+{
+    if (s->rsp_len < sizeof(s->rsp)) {
+        s->rsp[s->rsp_len++] = v;
+    }
+}
+
+/* runs the batch from s->next; stops while the engine waits for data */
+static void run_batch(USBRtsxState *s)
+{
+    while (s->next < s->ncmd) {
+        uint8_t *c = s->cmd + 8 + s->next * 4;
+        int type = c[0] >> 6;
+        uint16_t reg = R(((c[0] & 0x3F) << 8) | c[1]);
+        uint8_t mask = c[2], data = c[3];
+
+        if (s->e.pending) {
+            return;
+        }
+        rtsx_live_regs(s);
+        switch (type) {
+        case 0:
+            rsp_put(s, rtsx_reg_read(&s->e, reg));
+            break;
+        case 1:
+            rtsx_reg_write(&s->e, reg, mask, data);
+            if (s->e.pending == 1 && (s->flag & 0x02)) {
+                s->state = ST_DATA_IN;
+                s->data_len = s->e.ring_len;
+                s->data_pos = 0;
+            } else if (s->e.pending == 2 && (s->flag & 0x04)) {
+                s->state = ST_DATA_OUT;
+                s->data_len = s->e.pend_bytes;
+                s->data_pos = 0;
+            }
+            break;
+        case 2:
+            if ((rtsx_reg_read(&s->e, reg) & mask) != (data & mask)) {
+                s->bad++;
+            }
+            rsp_put(s, rtsx_reg_read(&s->e, reg));
+            break;
+        default:
+            break;
+        }
+        s->next++;
+    }
+    if (s->flag & 0x01) {
+        s->rsp_ready = true;
+    }
+    usb_wakeup(usb_ep_get(&s->dev, USB_TOKEN_IN, 1), 0);
+}
+
+static void rtsx_packet(USBRtsxState *s, uint8_t *p, uint32_t len)
+{
+    uint32_t n, addr, i;
+
+    if (len < 8 || memcmp(p, "RTCR", 4) != 0) {
+        s->bad++;
+        return;
+    }
+    s->rsp_len = 0;
+    s->rsp_ready = false;
+    switch (p[4]) {
+    case 0:                                         /* batch */
+        n = (p[5] << 8) | p[6];
+        if (8 + n * 4 > len) {
+            n = (len - 8) / 4;
+        }
+        memcpy(s->cmd, p, MIN(len, sizeof(s->cmd)));
+        s->ncmd = MIN(n, (sizeof(s->cmd) - 8) / 4);
+        s->next = 0;
+        s->flag = p[7];
+        s->state = ST_IDLE;
+        s->batches++;
+        run_batch(s);
+        break;
+    case 1:                                         /* sequential read */
+        n = (p[5] << 8) | p[6];
+        addr = (p[8] << 8) | p[9];
+        rtsx_live_regs(s);
+        for (i = 0; i < n && i < sizeof(s->rsp); i++) {
+            s->rsp[i] = s->e.regs[R(addr + i)];
+        }
+        s->rsp_len = n & ~3u;
+        s->rsp_ready = true;
+        usb_wakeup(usb_ep_get(&s->dev, USB_TOKEN_IN, 1), 0);
+        break;
+    case 2:                                         /* sequential write */
+        n = (p[5] << 8) | p[6];
+        addr = (p[8] << 8) | p[9];
+        for (i = 0; i < n && 12 + i < len; i++) {
+            s->e.regs[R(addr + i)] = p[12 + i];
+        }
+        break;
+    default:
+        s->bad++;
+        break;
+    }
+}
+
+static void rtsx_handle_data(USBDevice *dev, USBPacket *p)
+{
+    USBRtsxState *s = USB_RTSX(dev);
+    uint8_t buf[1024];
+    size_t n;
+
+    if (p->pid == USB_TOKEN_OUT && p->ep->nr == 2) {
+        if (s->state == ST_DATA_OUT) {
+            n = MIN(p->iov.size, s->data_len - s->data_pos);
+            usb_packet_copy(p, s->wbuf + s->data_pos, n);
+            s->data_pos += n;
+            if (s->data_pos >= s->data_len) {
+                s->state = ST_IDLE;
+                rtsx_dma_write(&s->e, s->wbuf, s->data_len);
+                run_batch(s);
+            }
+            return;
+        }
+        n = MIN(p->iov.size, sizeof(s->obuf) - s->olen);
+        usb_packet_copy(p, s->obuf + s->olen, n);
+        s->olen += n;
+        if (s->olen >= 8) {
+            uint32_t need;
+            uint32_t cnt = (s->obuf[5] << 8) | s->obuf[6];
+            if (memcmp(s->obuf, "RTCR", 4) != 0) {
+                s->bad++;
+                s->olen = 0;
+                return;
+            }
+            need = s->obuf[4] == 0 ? 8 + cnt * 4 : s->obuf[4] == 2 ? ((12 + cnt + 3) & ~3u) : 12;
+            if (need > sizeof(s->obuf)) {
+                need = sizeof(s->obuf);
+            }
+            if (s->olen >= need || n < p->ep->max_packet_size) {
+                uint32_t l = s->olen;
+                s->olen = 0;
+                rtsx_packet(s, s->obuf, l);
+            }
+        }
+        return;
+    }
+    if (p->pid == USB_TOKEN_IN && p->ep->nr == 1) {
+        if (s->state == ST_DATA_IN) {
+            n = MIN(p->iov.size, s->data_len - s->data_pos);
+            usb_packet_copy(p, s->e.ring + s->data_pos, n);
+            s->data_pos += n;
+            if (s->data_pos >= s->data_len) {
+                s->state = ST_IDLE;
+                rtsx_dma_read_done(&s->e);
+                run_batch(s);
+            }
+            return;
+        }
+        if (s->rsp_ready) {
+            n = MIN(p->iov.size, sizeof(s->rsp));
+            memset(buf, 0, sizeof(buf));
+            memcpy(buf, s->rsp, MIN(n, s->rsp_len));
+            usb_packet_copy(p, buf, n);
+            s->rsp_ready = false;
+            return;
+        }
+        p->status = USB_RET_NAK;
+        return;
+    }
+    if (p->pid == USB_TOKEN_IN && p->ep->nr == 3) {
+        p->status = USB_RET_NAK;
+        return;
+    }
+    p->status = USB_RET_STALL;
+}
+
+static void rtsx_handle_control(USBDevice *dev, USBPacket *p, int request, int value, int index, int length,
+                                uint8_t *data)
+{
+    USBRtsxState *s = USB_RTSX(dev);
+    int ret = usb_desc_handle_control(dev, p, request, value, index, length, data);
+
+    if (ret >= 0) {
+        return;
+    }
+    if (request == ((USB_DIR_OUT | USB_TYPE_VENDOR | USB_RECIP_DEVICE) << 8 | 0x00)) {
+        uint16_t a = ((value & 0xFF) << 8) | (value >> 8);
+        rtsx_reg_write(&s->e, R(a), index & 0xFF, index >> 8);
+        p->actual_length = 0;
+        return;
+    }
+    if (request == ((USB_DIR_IN | USB_TYPE_VENDOR | USB_RECIP_DEVICE) << 8 | 0x00) && length >= 1) {
+        uint16_t a = ((value & 0xFF) << 8) | (value >> 8);
+        rtsx_live_regs(s);
+        data[0] = s->e.regs[R(a)];
+        p->actual_length = 1;
+        return;
+    }
+    p->status = USB_RET_STALL;
+}
+
+static void rtsx_handle_reset(USBDevice *dev)
+{
+    USBRtsxState *s = USB_RTSX(dev);
+
+    rtsx_engine_init(&s->e, &s->sdbus, R(U_DATA_SOURCE), R(U_CARD_STOP));
+    s->e.regs[R(U_HW_VERSION)] = 0x01;
+    s->e.regs[R(U_CFG_MODE)] = 0x00;
+    s->e.regs[R(U_CFG_MODE_1)] = s->pid == 0x0140 ? 0x02 : 0x00;
+    s->e.regs[R(U_CARD_SHARE)] = s->lqfp ? 0x04 : 0x00;
+    s->state = ST_IDLE;
+    s->rsp_ready = false;
+    s->ncmd = s->next = 0;
+    s->olen = 0;
+}
+
+static void rtsx_realize(USBDevice *dev, Error **errp)
+{
+    USBRtsxState *s = USB_RTSX(dev);
+
+    desc_rtsx.id.idProduct = s->pid;
+    usb_desc_create_serial(dev);
+    usb_desc_init(dev);
+    qbus_init(&s->sdbus, sizeof(s->sdbus), TYPE_SD_BUS, DEVICE(dev), NULL);
+    s->wbuf = g_malloc0(RX_RING_MAX);
+    rtsx_handle_reset(dev);
+}
+
+static Property rtsx_props[] = {
+    DEFINE_PROP_UINT16("pid", USBRtsxState, pid, 0x0129),
+    DEFINE_PROP_BOOL("lqfp", USBRtsxState, lqfp, false),
+    DEFINE_PROP_UINT32("batches", USBRtsxState, batches, 0),
+    DEFINE_PROP_UINT32("bad", USBRtsxState, bad, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void rtsx_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    USBDeviceClass *uc = USB_DEVICE_CLASS(klass);
+
+    uc->realize = rtsx_realize;
+    uc->product_desc = "Realtek USB card reader (test)";
+    uc->usb_desc = &desc_rtsx;
+    uc->handle_reset = rtsx_handle_reset;
+    uc->handle_control = rtsx_handle_control;
+    uc->handle_data = rtsx_handle_data;
+    dc->desc = "Realtek RTS5129 USB card reader (test model)";
+    device_class_set_props(dc, rtsx_props);
+    set_bit(DEVICE_CATEGORY_STORAGE, dc->categories);
+}
+
+static const TypeInfo rtsx_info = {
+    .name = TYPE_USB_RTSX,
+    .parent = TYPE_USB_DEVICE,
+    .instance_size = sizeof(USBRtsxState),
+    .class_init = rtsx_class_init,
+};
+
+static void rtsx_register(void)
+{
+    type_register_static(&rtsx_info);
+}
+
+type_init(rtsx_register)
diff --git a/hw/usb/dev-uac.c b/hw/usb/dev-uac.c
new file mode 100644
index 0000000..264bcd2
--- /dev/null
+++ b/hw/usb/dev-uac.c
@@ -0,0 +1,1013 @@
+/*
+ * QEMU USB Audio Class 1 / 2 test device ("usb-uac").
+ *
+ * Written for testing the USBNT / AUDIONT drivers.  Unlike usb-audio it
+ * offers what real devices do and drivers must cope with:
+ *
+ *   uac=1  USB Audio 1.0, full speed       uac=2  USB Audio 2.0 (hs=on: high speed)
+ *   playback: alt 1 16-bit stereo, alt 2 24-bit stereo, (UAC2) alt 3 32-bit stereo
+ *   capture : alt 1 16-bit stereo, alt 2 16-bit mono (capture=on)
+ *   rates   : 44100 / 48000 / 96000 (ratemask bits 0/1/2)
+ *   sync    : asynchronous OUT with an explicit feedback endpoint (feedback=on,
+ *             fbppm = device clock offset) or adaptive OUT (feedback=off)
+ *   controls: feature unit mute + volume on both paths, UAC1 endpoint sampling
+ *             frequency control, UAC2 clock source frequency / validity
+ *
+ * Playback is decoded to S16 stereo and sent to the audio backend; capture
+ * produces a 1000 Hz (left) / 1500 Hz (right) sine at -6 dBFS.  With debug=1
+ * every class request, interface change and a periodic stream summary go to
+ * stderr ("uac: ..."), which the test scripts parse.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qemu/host-utils.h"
+#include "qapi/error.h"
+#include "hw/qdev-properties.h"
+#include "hw/usb.h"
+#include "migration/vmstate.h"
+#include "desc.h"
+#include "audio/audio.h"
+#include "qom/object.h"
+#include <math.h>
+
+#define UAC_VENDOR   0x46f4
+#define UAC_PRODUCT1 0x0101
+#define UAC_PRODUCT2 0x0102
+
+#define U16(x) ((x) & 0xff), (((x) >> 8) & 0xff)
+#define U24(x) U16(x), (((x) >> 16) & 0xff)
+#define U32(x) U24(x), (((x) >> 24) & 0xff)
+
+#define ID_CLOCK    10
+#define ID_IT_USB   1
+#define ID_FU_PLAY  2
+#define ID_OT_SPK   3
+#define ID_IT_MIC   4
+#define ID_FU_REC   5
+#define ID_OT_USB   6
+
+#define EP_OUT      0x01
+#define EP_FB       0x81
+#define EP_IN       0x82
+#define EP_MIDI     0x03
+
+enum {
+    STR_NULL, STR_MFG, STR_PRODUCT, STR_SERIAL, STR_CONFIG, STR_CONTROL,
+    STR_PLAY, STR_REC,
+};
+
+static const USBDescStrings uac_strings = {
+    [STR_MFG]     = "QEMU",
+    [STR_PRODUCT] = "QEMU UAC Test Device",
+    [STR_SERIAL]  = "1",
+    [STR_CONFIG]  = "Audio",
+    [STR_CONTROL] = "Audio Control",
+    [STR_PLAY]    = "Playback",
+    [STR_REC]     = "Capture",
+};
+
+static const uint32_t uac_rates[3] = { 44100, 48000, 96000 };
+
+struct fifo {
+    uint8_t *data;
+    size_t size;
+    uint64_t prod, cons;
+    bool primed;                /* enough queued to absorb frame timing jitter */
+};
+
+struct UACState {
+    USBDevice dev;
+    QEMUSoundCard card;
+
+    /* properties */
+    uint32_t version;
+    bool hs;
+    bool capture;
+    bool feedback;
+    int32_t fbppm;
+    uint32_t ratemask;
+    uint32_t hsint;
+    uint32_t debug;
+    bool midi;
+    bool implicit;
+
+    /* descriptors (built at realize) */
+    USBDesc desc;
+    USBDescDevice devdesc;
+    USBDescConfig conf;
+    USBDescIfaceAssoc iad;
+    USBDescIface ifs[12];
+    int nifs;
+
+    /* runtime */
+    int out_alt, in_alt;
+    uint32_t rate_out, rate_in;
+    SWVoiceOut *vout;
+    struct audsettings as;
+    struct fifo fifo;
+    bool mute[8];
+    int16_t vol[8];
+    double phase_l, phase_r;
+    uint64_t in_acc;
+    /* statistics */
+    uint64_t out_packets, out_frames, out_bad, out_overrun, out_underrun;
+    uint64_t fb_packets, in_packets, in_frames;
+    uint64_t last_report;
+    uint32_t min_pkt, max_pkt;
+};
+typedef struct UACState UACState;
+
+#define TYPE_USB_UAC "usb-uac"
+OBJECT_DECLARE_SIMPLE_TYPE(UACState, USB_UAC)
+
+#define DBG(s, ...) do { if ((s)->debug) { fprintf(stderr, "uac: " __VA_ARGS__); } } while (0)
+
+/* ------------------------------------------------------------------ */
+/* descriptor building                                                 */
+/* ------------------------------------------------------------------ */
+
+static USBDescOther *blob(const uint8_t *data, size_t len)
+{
+    USBDescOther *o = g_new0(USBDescOther, 1);
+    uint8_t *d = g_malloc(len);
+    memcpy(d, data, len);
+    o->length = len;
+    o->data = d;
+    return o;
+}
+
+/* collects class specific descriptors into one array */
+typedef struct {
+    USBDescOther list[16];
+    int n;
+} DescList;
+
+static void dl_add(DescList *l, const uint8_t *data, size_t len)
+{
+    USBDescOther *o = blob(data, len);
+    l->list[l->n++] = *o;
+    g_free(o);
+}
+
+static USBDescOther *dl_finish(DescList *l)
+{
+    USBDescOther *a = g_new0(USBDescOther, l->n);
+    memcpy(a, l->list, sizeof(USBDescOther) * l->n);
+    return a;
+}
+
+static int nrates(UACState *s)
+{
+    int i, n = 0;
+    for (i = 0; i < 3; i++) {
+        if (s->ratemask & (1 << i)) {
+            n++;
+        }
+    }
+    return n;
+}
+
+static void build_ac(UACState *s, USBDescIface *ifc)
+{
+    DescList l = { .n = 0 };
+    int total = 0, i;
+    bool v2 = s->version == 2;
+
+    memset(ifc, 0, sizeof(*ifc));
+    ifc->bInterfaceNumber = 0;
+    ifc->bInterfaceClass = USB_CLASS_AUDIO;
+    ifc->bInterfaceSubClass = USB_SUBCLASS_AUDIO_CONTROL;
+    ifc->bInterfaceProtocol = v2 ? 0x20 : 0x00;
+    ifc->iInterface = STR_CONTROL;
+
+    if (v2) {
+        uint8_t hdr[9] = { 9, USB_DT_CS_INTERFACE, 0x01, U16(0x0200), 0x08, U16(0), 0x00 };
+        uint8_t clk[8] = { 8, USB_DT_CS_INTERFACE, 0x0A, ID_CLOCK, 0x03, 0x07, 0x00, 0x00 };
+        uint8_t it[17] = { 17, USB_DT_CS_INTERFACE, 0x02, ID_IT_USB, U16(0x0101), 0, ID_CLOCK,
+                           2, U32(3), 0, U16(0), 0 };
+        uint8_t fu[18] = { 18, USB_DT_CS_INTERFACE, 0x06, ID_FU_PLAY, ID_IT_USB,
+                           U32(0x0f), U32(0x0c), U32(0x0c), 0 };
+        uint8_t ot[12] = { 12, USB_DT_CS_INTERFACE, 0x03, ID_OT_SPK, U16(0x0301), 0, ID_FU_PLAY,
+                           ID_CLOCK, U16(0), 0 };
+        uint8_t mic[17] = { 17, USB_DT_CS_INTERFACE, 0x02, ID_IT_MIC, U16(0x0201), 0, ID_CLOCK,
+                            2, U32(3), 0, U16(0), 0 };
+        uint8_t fu2[18] = { 18, USB_DT_CS_INTERFACE, 0x06, ID_FU_REC, ID_IT_MIC,
+                            U32(0x0f), U32(0x0c), U32(0x0c), 0 };
+        uint8_t ot2[12] = { 12, USB_DT_CS_INTERFACE, 0x03, ID_OT_USB, U16(0x0101), 0, ID_FU_REC,
+                            ID_CLOCK, U16(0), 0 };
+        total = 9 + 8 + 17 + 18 + 12 + (s->capture ? 17 + 18 + 12 : 0);
+        hdr[6] = total & 0xff;
+        hdr[7] = total >> 8;
+        dl_add(&l, hdr, 9);
+        dl_add(&l, clk, 8);
+        dl_add(&l, it, 17);
+        dl_add(&l, fu, 18);
+        dl_add(&l, ot, 12);
+        if (s->capture) {
+            dl_add(&l, mic, 17);
+            dl_add(&l, fu2, 18);
+            dl_add(&l, ot2, 12);
+        }
+    } else {
+        uint8_t hdr[11] = { 0, USB_DT_CS_INTERFACE, 0x01, U16(0x0100), U16(0), 0, 1, 2, 3 };
+        uint8_t it[12] = { 12, USB_DT_CS_INTERFACE, 0x02, ID_IT_USB, U16(0x0101), 0, 2, U16(3), 0, 0 };
+        uint8_t fu[10] = { 10, USB_DT_CS_INTERFACE, 0x06, ID_FU_PLAY, ID_IT_USB, 1, 0x03, 0x00, 0x00, 0 };
+        uint8_t ot[9] = { 9, USB_DT_CS_INTERFACE, 0x03, ID_OT_SPK, U16(0x0301), 0, ID_FU_PLAY, 0 };
+        uint8_t mic[12] = { 12, USB_DT_CS_INTERFACE, 0x02, ID_IT_MIC, U16(0x0201), 0, 2, U16(3), 0, 0 };
+        uint8_t fu2[10] = { 10, USB_DT_CS_INTERFACE, 0x06, ID_FU_REC, ID_IT_MIC, 1, 0x03, 0x00, 0x00, 0 };
+        uint8_t ot2[9] = { 9, USB_DT_CS_INTERFACE, 0x03, ID_OT_USB, U16(0x0101), 0, ID_FU_REC, 0 };
+        int ncol = 1 + (s->capture ? 1 : 0) + (s->midi ? 1 : 0);
+        int hlen = 8 + ncol;
+        hdr[0] = hlen;
+        hdr[7] = ncol;
+        hdr[8] = 1;
+        hdr[9] = s->capture ? 2 : 3;
+        hdr[10] = 3;
+        total = hlen + 12 + 10 + 9 + (s->capture ? 12 + 10 + 9 : 0);
+        hdr[5] = total & 0xff;
+        hdr[6] = total >> 8;
+        dl_add(&l, hdr, hlen);
+        dl_add(&l, it, 12);
+        dl_add(&l, fu, 10);
+        dl_add(&l, ot, 9);
+        if (s->capture) {
+            dl_add(&l, mic, 12);
+            dl_add(&l, fu2, 10);
+            dl_add(&l, ot2, 9);
+        }
+    }
+    (void)i;
+    ifc->ndesc = l.n;
+    ifc->descs = dl_finish(&l);
+}
+
+/* bytes per packet at the highest rate, with room for one extra frame */
+static uint16_t max_packet(UACState *s, int chans, int bytes)
+{
+    uint32_t maxrate = 0;
+    int i;
+    for (i = 0; i < 3; i++) {
+        if (s->ratemask & (1 << i)) {
+            maxrate = uac_rates[i];
+        }
+    }
+    if (s->hs) {
+        uint32_t per = 8000 >> (s->hsint - 1);
+        return (maxrate / per + 2) * chans * bytes;
+    }
+    return (maxrate / 1000 + 2) * chans * bytes;
+}
+
+static void build_as(UACState *s, USBDescIface *ifc, int ifnum, int alt, bool play)
+{
+    DescList l = { .n = 0 };
+    bool v2 = s->version == 2;
+    int chans = 2, sub = 2, bits = 16;
+    USBDescEndpoint *eps;
+    int neps = 0;
+
+    memset(ifc, 0, sizeof(*ifc));
+    ifc->bInterfaceNumber = ifnum;
+    ifc->bAlternateSetting = alt;
+    ifc->bInterfaceClass = USB_CLASS_AUDIO;
+    ifc->bInterfaceSubClass = USB_SUBCLASS_AUDIO_STREAMING;
+    ifc->bInterfaceProtocol = v2 ? 0x20 : 0x00;
+    ifc->iInterface = play ? STR_PLAY : STR_REC;
+    if (alt == 0) {
+        return;
+    }
+    if (play) {
+        if (alt == 2) {
+            sub = 3; bits = 24;
+        } else if (alt == 3) {
+            sub = 4; bits = 24;
+        }
+    } else if (alt == 2) {
+        chans = 1;
+    }
+
+    if (v2) {
+        uint8_t gen[16] = { 16, USB_DT_CS_INTERFACE, 0x01, play ? ID_IT_USB : ID_OT_USB, 0x00, 0x01,
+                            U32(1), chans, U32(chans == 2 ? 3 : 4), 0 };
+        uint8_t fmt[6] = { 6, USB_DT_CS_INTERFACE, 0x02, 0x01, sub, bits };
+        dl_add(&l, gen, 16);
+        dl_add(&l, fmt, 6);
+    } else {
+        uint8_t gen[7] = { 7, USB_DT_CS_INTERFACE, 0x01, play ? ID_IT_USB : ID_OT_USB, 1, U16(1) };
+        uint8_t fmt[8 + 9];
+        int n = 0, i;
+        fmt[0] = 8 + 3 * nrates(s);
+        fmt[1] = USB_DT_CS_INTERFACE;
+        fmt[2] = 0x02;
+        fmt[3] = 0x01;
+        fmt[4] = chans;
+        fmt[5] = sub;
+        fmt[6] = bits;
+        fmt[7] = nrates(s);
+        for (i = 0; i < 3; i++) {
+            if (s->ratemask & (1 << i)) {
+                fmt[8 + 3 * n] = uac_rates[i] & 0xff;
+                fmt[9 + 3 * n] = (uac_rates[i] >> 8) & 0xff;
+                fmt[10 + 3 * n] = uac_rates[i] >> 16;
+                n++;
+            }
+        }
+        dl_add(&l, gen, 7);
+        dl_add(&l, fmt, fmt[0]);
+    }
+    ifc->ndesc = l.n;
+    ifc->descs = dl_finish(&l);
+
+    eps = g_new0(USBDescEndpoint, 2);
+    if (play) {
+        eps[0].bEndpointAddress = EP_OUT;
+        eps[0].bmAttributes = (s->feedback || s->implicit) ? 0x05 : 0x09; /* iso async / adaptive */
+        eps[0].wMaxPacketSize = max_packet(s, chans, sub);
+        eps[0].bInterval = s->hs ? s->hsint : 1;
+        if (!v2) {
+            uint8_t cs[7] = { 7, USB_DT_CS_ENDPOINT, 0x01, 0x01, 0, U16(0) };
+            eps[0].is_audio = 1;
+            eps[0].bSynchAddress = s->feedback ? EP_FB : 0;
+            eps[0].extra = g_memdup2(cs, 7);
+        } else {
+            uint8_t cs[8] = { 8, USB_DT_CS_ENDPOINT, 0x01, 0x00, 0x00, 0, U16(0) };
+            eps[0].extra = g_memdup2(cs, 8);
+        }
+        neps = 1;
+        if (s->feedback) {
+            eps[1].bEndpointAddress = EP_FB;
+            eps[1].bmAttributes = v2 ? 0x11 : 0x01;           /* iso, feedback usage (UAC2) */
+            eps[1].wMaxPacketSize = (v2 && s->hs) ? 4 : 3;
+            eps[1].bInterval = s->hs ? 4 : 1;
+            if (!v2) {
+                eps[1].is_audio = 1;
+                eps[1].bRefresh = 2;                           /* every 4 ms */
+            }
+            neps = 2;
+        }
+    } else {
+        eps[0].bEndpointAddress = EP_IN;
+        eps[0].bmAttributes = 0x05;
+        eps[0].wMaxPacketSize = max_packet(s, chans, sub);
+        eps[0].bInterval = s->hs ? s->hsint : 1;
+        if (!v2) {
+            uint8_t cs[7] = { 7, USB_DT_CS_ENDPOINT, 0x01, 0x01, 0, U16(0) };
+            eps[0].is_audio = 1;
+            eps[0].extra = g_memdup2(cs, 7);
+        } else {
+            uint8_t cs[8] = { 8, USB_DT_CS_ENDPOINT, 0x01, 0x00, 0x00, 0, U16(0) };
+            eps[0].extra = g_memdup2(cs, 8);
+        }
+        neps = 1;
+    }
+    ifc->bNumEndpoints = neps;
+    ifc->eps = eps;
+}
+
+/* MIDI streaming: one embedded IN jack feeding an external OUT jack, bulk OUT */
+static void build_ms(UACState *s, USBDescIface *ifc, int ifnum)
+{
+    DescList l = { .n = 0 };
+    uint8_t hdr[7] = { 7, USB_DT_CS_INTERFACE, 0x01, U16(0x0100), U16(7 + 6 + 9) };
+    uint8_t jin[6] = { 6, USB_DT_CS_INTERFACE, 0x02, 0x01, 1, 0 };
+    uint8_t jout[9] = { 9, USB_DT_CS_INTERFACE, 0x03, 0x02, 2, 1, 1, 1, 0 };
+    uint8_t cs[5] = { 5, USB_DT_CS_ENDPOINT, 0x01, 1, 1 };
+    USBDescEndpoint *ep;
+
+    memset(ifc, 0, sizeof(*ifc));
+    ifc->bInterfaceNumber = ifnum;
+    ifc->bInterfaceClass = USB_CLASS_AUDIO;
+    ifc->bInterfaceSubClass = 3;
+    dl_add(&l, hdr, 7);
+    dl_add(&l, jin, 6);
+    dl_add(&l, jout, 9);
+    ifc->ndesc = l.n;
+    ifc->descs = dl_finish(&l);
+    ep = g_new0(USBDescEndpoint, 1);
+    ep->bEndpointAddress = EP_MIDI;
+    ep->bmAttributes = 0x02;
+    ep->wMaxPacketSize = s->hs ? 512 : 64;
+    ep->is_audio = s->version == 1;
+    ep->extra = g_memdup2(cs, 5);
+    ifc->bNumEndpoints = 1;
+    ifc->eps = ep;
+}
+
+static void build_desc(UACState *s)
+{
+    int n = 0, alt;
+    int playalts = s->version == 2 ? 3 : 2;
+
+    build_ac(s, &s->ifs[n++]);
+    for (alt = 0; alt <= playalts; alt++) {
+        build_as(s, &s->ifs[n++], 1, alt, true);
+    }
+    if (s->capture) {
+        for (alt = 0; alt <= 2; alt++) {
+            build_as(s, &s->ifs[n++], 2, alt, false);
+        }
+    }
+    if (s->midi) {
+        build_ms(s, &s->ifs[n++], s->capture ? 3 : 2);
+    }
+    s->nifs = n;
+
+    s->devdesc.bcdUSB = s->hs ? 0x0200 : 0x0110;
+    s->devdesc.bMaxPacketSize0 = 64;
+    s->devdesc.bNumConfigurations = 1;
+    s->devdesc.confs = &s->conf;
+    s->conf.bNumInterfaces = (s->capture ? 3 : 2) + (s->midi ? 1 : 0);
+    s->conf.bConfigurationValue = 1;
+    s->conf.iConfiguration = STR_CONFIG;
+    s->conf.bmAttributes = USB_CFG_ATT_ONE | USB_CFG_ATT_SELFPOWER;
+    s->conf.bMaxPower = 50;
+    if (s->version == 2) {
+        /* UAC2 functions are announced with an interface association */
+        s->devdesc.bDeviceClass = 0xEF;
+        s->devdesc.bDeviceSubClass = 0x02;
+        s->devdesc.bDeviceProtocol = 0x01;
+        s->iad.bFirstInterface = 0;
+        s->iad.bInterfaceCount = s->conf.bNumInterfaces;
+        s->iad.bFunctionClass = USB_CLASS_AUDIO;
+        s->iad.bFunctionSubClass = 0;
+        s->iad.bFunctionProtocol = 0x20;
+        s->iad.nif = s->nifs;
+        s->iad.ifs = s->ifs;
+        s->conf.nif_groups = 1;
+        s->conf.if_groups = &s->iad;
+    } else {
+        s->conf.nif = s->nifs;
+        s->conf.ifs = s->ifs;
+    }
+
+    s->desc.id.idVendor = UAC_VENDOR;
+    s->desc.id.idProduct = s->version == 2 ? UAC_PRODUCT2 : UAC_PRODUCT1;
+    s->desc.id.bcdDevice = 0x0100;
+    s->desc.id.iManufacturer = STR_MFG;
+    s->desc.id.iProduct = STR_PRODUCT;
+    s->desc.id.iSerialNumber = STR_SERIAL;
+    if (s->hs) {
+        s->desc.high = &s->devdesc;
+    } else {
+        s->desc.full = &s->devdesc;
+    }
+    s->desc.str = uac_strings;
+}
+
+/* ------------------------------------------------------------------ */
+/* playback                                                            */
+/* ------------------------------------------------------------------ */
+
+static void out_cb(void *opaque, int avail)
+{
+    UACState *s = opaque;
+
+    /* like a real device's elastic buffer: start (and restart after running
+       empty) only with 16 ms queued, so bursty frame timing of emulated host
+       controllers does not cut samples out of the stream */
+    if (!s->fifo.primed) {
+        if (s->fifo.prod - s->fifo.cons < s->fifo.size / 4) {
+            if (s->out_alt) {
+                s->out_underrun++;
+            }
+            return;
+        }
+        s->fifo.primed = true;
+    }
+    while (avail > 0) {
+        size_t used = s->fifo.prod - s->fifo.cons;
+        size_t off = s->fifo.cons % s->fifo.size;
+        size_t len = MIN(used, s->fifo.size - off);
+        size_t w;
+        if (len == 0) {
+            if (s->out_alt) {
+                s->out_underrun++;
+            }
+            s->fifo.primed = false;
+            return;
+        }
+        w = AUD_write(s->vout, s->fifo.data + off, MIN(len, (size_t)avail));
+        s->fifo.cons += w;
+        avail -= w;
+        if (w == 0) {
+            return;
+        }
+    }
+}
+
+static void open_voice(UACState *s)
+{
+    uint32_t rate = s->rate_out;
+    if ((s->feedback || s->implicit) && s->fbppm) {
+        rate = (uint32_t)((double)rate * (1.0 + s->fbppm / 1e6) + 0.5);
+    }
+    s->as.freq = rate;
+    s->as.nchannels = 2;
+    s->as.fmt = AUDIO_FORMAT_S16;
+    s->as.endianness = 0;
+    s->vout = AUD_open_out(&s->card, s->vout, TYPE_USB_UAC, s, out_cb, &s->as);
+    g_free(s->fifo.data);
+    s->fifo.size = rate / 1000 * 4 * 64;          /* 64 ms */
+    s->fifo.data = g_malloc0(s->fifo.size);
+    s->fifo.prod = s->fifo.cons = 0;
+    s->fifo.primed = false;
+    AUD_set_active_out(s->vout, s->out_alt != 0);
+    DBG(s, "voice %u Hz\n", rate);
+}
+
+static void report(UACState *s, bool force)
+{
+    uint64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    if (!s->debug || (!force && now - s->last_report < 1000)) {
+        return;
+    }
+    s->last_report = now;
+    DBG(s, "stats out_alt=%d rate=%u pkts=%" PRIu64 " frames=%" PRIu64 " pkt=%u..%u bad=%" PRIu64
+        " overrun=%" PRIu64 " underrun=%" PRIu64 " fifo=%" PRIu64 " fb=%" PRIu64 " in_alt=%d in_pkts=%"
+        PRIu64 " in_frames=%" PRIu64 "\n",
+        s->out_alt, s->rate_out, s->out_packets, s->out_frames, s->min_pkt, s->max_pkt, s->out_bad,
+        s->out_overrun, s->out_underrun, s->fifo.prod - s->fifo.cons, s->fb_packets, s->in_alt,
+        s->in_packets, s->in_frames);
+    s->min_pkt = 0xFFFF;
+    s->max_pkt = 0;
+}
+
+static void handle_out(UACState *s, USBPacket *p)
+{
+    int sub = s->out_alt == 2 ? 3 : (s->out_alt == 3 ? 4 : 2);
+    int fsz = sub * 2;
+    size_t len = p->iov.size;
+    uint8_t buf[4096];
+    size_t frames, i;
+
+    if (!s->out_alt) {
+        p->status = USB_RET_STALL;
+        return;
+    }
+    if (len > sizeof(buf)) {
+        len = sizeof(buf);
+    }
+    usb_packet_copy(p, buf, len);
+    if (len % fsz) {
+        s->out_bad++;
+    }
+    frames = len / fsz;
+    s->out_packets++;
+    s->out_frames += frames;
+    if (frames < s->min_pkt) {
+        s->min_pkt = frames;
+    }
+    if (frames > s->max_pkt) {
+        s->max_pkt = frames;
+    }
+    for (i = 0; i < frames; i++) {
+        int16_t lr[2];
+        int c;
+        for (c = 0; c < 2; c++) {
+            const uint8_t *d = buf + i * fsz + c * sub;
+            int16_t v = (int16_t)(d[sub - 2] | (d[sub - 1] << 8));    /* top 16 bits */
+            if (s->mute[0] || s->mute[1 + c]) {
+                v = 0;
+            }
+            lr[c] = v;
+        }
+        if (s->fifo.prod - s->fifo.cons + 4 > s->fifo.size) {
+            s->out_overrun++;
+            break;
+        }
+        memcpy(s->fifo.data + (s->fifo.prod % s->fifo.size), lr, 4);
+        s->fifo.prod += 4;
+    }
+    report(s, false);
+}
+
+static void handle_feedback(UACState *s, USBPacket *p)
+{
+    double rate = s->rate_out * (1.0 + s->fbppm / 1e6);
+    uint8_t v[4];
+    uint32_t f;
+    int n;
+
+    if (s->version == 2 && s->hs) {
+        f = (uint32_t)(rate / 8000.0 * 65536.0 + 0.5);        /* 16.16 per microframe */
+        v[0] = f; v[1] = f >> 8; v[2] = f >> 16; v[3] = f >> 24;
+        n = 4;
+    } else {
+        f = (uint32_t)(rate / 1000.0 * 16384.0 + 0.5);        /* 10.14 per frame */
+        v[0] = f; v[1] = f >> 8; v[2] = f >> 16;
+        n = 3;
+    }
+    if (p->iov.size < n) {
+        n = p->iov.size;
+    }
+    usb_packet_copy(p, v, n);
+    s->fb_packets++;
+}
+
+/* ------------------------------------------------------------------ */
+/* capture                                                             */
+/* ------------------------------------------------------------------ */
+
+static void handle_in(UACState *s, USBPacket *p)
+{
+    int chans = s->in_alt == 2 ? 1 : 2;
+    int fsz = 2 * chans;
+    uint32_t per = s->hs ? (8000 >> (s->hsint - 1)) : 1000;
+    uint8_t buf[2048];
+    uint32_t frames, i;
+
+    if (!s->in_alt) {
+        p->status = USB_RET_STALL;
+        return;
+    }
+    /* exact long term rate: frames in this packet from an accumulator */
+    /* the device clock (fbppm) also paces capture: implicit feedback */
+    s->in_acc += (uint64_t)s->rate_in * (uint64_t)(1000000 + s->fbppm);
+    frames = s->in_acc / ((uint64_t)per * 1000000);
+    s->in_acc %= (uint64_t)per * 1000000;
+    if (frames * fsz > p->iov.size) {
+        frames = p->iov.size / fsz;
+    }
+    if (frames * fsz > sizeof(buf)) {
+        frames = sizeof(buf) / fsz;
+    }
+    for (i = 0; i < frames; i++) {
+        int16_t l = (int16_t)(16384.0 * sin(s->phase_l));
+        int16_t r = (int16_t)(16384.0 * sin(s->phase_r));
+        s->phase_l += 2 * M_PI * 1000.0 / s->rate_in;
+        s->phase_r += 2 * M_PI * 1500.0 / s->rate_in;
+        if (s->phase_l > 2 * M_PI) {
+            s->phase_l -= 2 * M_PI;
+        }
+        if (s->phase_r > 2 * M_PI) {
+            s->phase_r -= 2 * M_PI;
+        }
+        if (s->mute[4]) {
+            l = r = 0;
+        }
+        buf[i * fsz] = l;
+        buf[i * fsz + 1] = l >> 8;
+        if (chans == 2) {
+            buf[i * fsz + 2] = r;
+            buf[i * fsz + 3] = r >> 8;
+        }
+    }
+    usb_packet_copy(p, buf, frames * fsz);
+    s->in_packets++;
+    s->in_frames += frames;
+}
+
+static void uac_handle_data(USBDevice *dev, USBPacket *p)
+{
+    UACState *s = USB_UAC(dev);
+
+    if (p->pid == USB_TOKEN_OUT && p->ep->nr == (EP_OUT & 0xf)) {
+        handle_out(s, p);
+        return;
+    }
+    if (p->pid == USB_TOKEN_IN && p->ep->nr == (EP_FB & 0xf) && s->feedback) {
+        handle_feedback(s, p);
+        return;
+    }
+    if (p->pid == USB_TOKEN_IN && p->ep->nr == (EP_IN & 0xf) && s->capture) {
+        handle_in(s, p);
+        return;
+    }
+    if (p->pid == USB_TOKEN_OUT && p->ep->nr == (EP_MIDI & 0xf) && s->midi) {
+        uint8_t b[512];
+        size_t len = MIN(p->iov.size, sizeof(b)), i;
+        usb_packet_copy(p, b, len);
+        for (i = 0; i + 3 < len; i += 4) {
+            DBG(s, "midi %02x %02x %02x %02x\n", b[i], b[i + 1], b[i + 2], b[i + 3]);
+        }
+        return;
+    }
+    p->status = USB_RET_STALL;
+}
+
+/* ------------------------------------------------------------------ */
+/* controls                                                            */
+/* ------------------------------------------------------------------ */
+
+static bool rate_ok(UACState *s, uint32_t r)
+{
+    int i;
+    for (i = 0; i < 3; i++) {
+        if ((s->ratemask & (1 << i)) && uac_rates[i] == r) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void set_rate(UACState *s, bool out, uint32_t r)
+{
+    if (!rate_ok(s, r)) {
+        DBG(s, "SET rate %u rejected\n", r);
+        return;
+    }
+    DBG(s, "SET rate %s %u\n", out ? "out" : "in", r);
+    if (out || s->version == 2) {
+        s->rate_out = r;
+        open_voice(s);
+    }
+    if (!out || s->version == 2) {
+        s->rate_in = r;
+        s->in_acc = 0;
+    }
+}
+
+/* index into mute/vol: 0..3 playback master/L/R, 4..7 capture */
+static int ctl_slot(uint8_t unit, uint8_t cn)
+{
+    if (cn > 2) {
+        return -1;
+    }
+    if (unit == ID_FU_PLAY) {
+        return cn;
+    }
+    if (unit == ID_FU_REC) {
+        return 4 + cn;
+    }
+    return -1;
+}
+
+static int uac2_request(UACState *s, int request, int value, int index, int length, uint8_t *data)
+{
+    uint8_t cs = value >> 8, cn = value & 0xff, ent = index >> 8;
+    bool get = (request >> 8) & 0x80;
+    uint8_t req = request & 0xff;
+    int slot;
+
+    if (ent == ID_CLOCK) {
+        if (cs == 1 && req == 1) {                      /* SAM_FREQ CUR */
+            if (get) {
+                uint32_t r = s->rate_out;
+                data[0] = r; data[1] = r >> 8; data[2] = r >> 16; data[3] = r >> 24;
+                return 4;
+            }
+            set_rate(s, true, data[0] | (data[1] << 8) | (data[2] << 16) | ((uint32_t)data[3] << 24));
+            return 0;
+        }
+        if (cs == 1 && req == 2 && get) {               /* SAM_FREQ RANGE */
+            int i, n = 0;
+            uint8_t out[2 + 12 * 3];
+            for (i = 0; i < 3; i++) {
+                if (s->ratemask & (1 << i)) {
+                    uint8_t *e = out + 2 + 12 * n;
+                    uint32_t r = uac_rates[i];
+                    e[0] = r; e[1] = r >> 8; e[2] = r >> 16; e[3] = 0;
+                    e[4] = r; e[5] = r >> 8; e[6] = r >> 16; e[7] = 0;
+                    memset(e + 8, 0, 4);
+                    n++;
+                }
+            }
+            out[0] = n; out[1] = 0;
+            DBG(s, "GET clock range (%d)\n", length);
+            n = MIN(2 + 12 * n, length);
+            memcpy(data, out, n);
+            return n;
+        }
+        if (cs == 2 && req == 1 && get) {               /* CLOCK_VALID */
+            data[0] = 1;
+            return 1;
+        }
+        return -1;
+    }
+    slot = ctl_slot(ent, cn);
+    if (slot < 0) {
+        return -1;
+    }
+    if (cs == 1 && req == 1) {                          /* MUTE CUR */
+        if (get) {
+            data[0] = s->mute[slot];
+            return 1;
+        }
+        s->mute[slot] = data[0] & 1;
+        DBG(s, "SET mute unit %u ch %u = %u\n", ent, cn, data[0] & 1);
+        return 0;
+    }
+    if (cs == 2 && req == 1) {                          /* VOLUME CUR */
+        if (get) {
+            data[0] = s->vol[slot]; data[1] = s->vol[slot] >> 8;
+            return 2;
+        }
+        s->vol[slot] = (int16_t)(data[0] | (data[1] << 8));
+        DBG(s, "SET volume unit %u ch %u = %d\n", ent, cn, s->vol[slot]);
+        return 0;
+    }
+    if (cs == 2 && req == 2 && get) {                   /* VOLUME RANGE */
+        uint8_t r[8] = { 1, 0, U16(0xC400), U16(0x0600), U16(0x0100) };  /* -60 .. +6 dB, 1 dB */
+        int n = MIN(8, length);
+        memcpy(data, r, n);
+        return n;
+    }
+    return -1;
+}
+
+static int uac1_request(UACState *s, int request, int value, int index, int length, uint8_t *data)
+{
+    uint8_t cs = value >> 8, cn = value & 0xff, unit = index >> 8;
+    uint8_t req = request & 0xff;
+    bool ep = (request >> 8 & 0x1f) == 2;
+    int slot;
+
+    if (ep) {
+        if (cs == 1 && req == 0x01) {                   /* SET_CUR SAMPLING_FREQ */
+            set_rate(s, (index & 0x80) == 0, data[0] | (data[1] << 8) | (data[2] << 16));
+            return 0;
+        }
+        if (cs == 1 && req == 0x81) {
+            uint32_t r = (index & 0x80) ? s->rate_in : s->rate_out;
+            data[0] = r; data[1] = r >> 8; data[2] = r >> 16;
+            return 3;
+        }
+        return -1;
+    }
+    slot = ctl_slot(unit, cn);
+    if (slot < 0) {
+        return -1;
+    }
+    if (cs == 1) {
+        if (req == 0x01) {
+            s->mute[slot] = data[0] & 1;
+            DBG(s, "SET mute unit %u ch %u = %u\n", unit, cn, data[0] & 1);
+            return 0;
+        }
+        if (req == 0x81) {
+            data[0] = s->mute[slot];
+            return 1;
+        }
+        return -1;
+    }
+    if (cs == 2) {
+        int16_t v;
+        switch (req) {
+        case 0x01:
+            s->vol[slot] = (int16_t)(data[0] | (data[1] << 8));
+            DBG(s, "SET volume unit %u ch %u = %d\n", unit, cn, s->vol[slot]);
+            return 0;
+        case 0x81: v = s->vol[slot]; break;
+        case 0x82: v = (int16_t)0xC400; break;
+        case 0x83: v = 0x0600; break;
+        case 0x84: v = 0x0100; break;
+        default: return -1;
+        }
+        data[0] = v; data[1] = v >> 8;
+        return 2;
+    }
+    return -1;
+}
+
+static void uac_handle_control(USBDevice *dev, USBPacket *p, int request, int value,
+                               int index, int length, uint8_t *data)
+{
+    UACState *s = USB_UAC(dev);
+    int ret;
+
+    ret = usb_desc_handle_control(dev, p, request, value, index, length, data);
+    if (ret >= 0) {
+        return;
+    }
+    if (((request >> 8) & 0x60) != 0x20) {
+        p->status = USB_RET_STALL;
+        return;
+    }
+    ret = (s->version == 2) ? uac2_request(s, request, value, index, length, data)
+                            : uac1_request(s, request, value, index, length, data);
+    if (ret < 0) {
+        DBG(s, "request %04x value %04x index %04x len %d stalled\n", request, value, index, length);
+        p->status = USB_RET_STALL;
+        return;
+    }
+    p->actual_length = ret;
+}
+
+static void uac_set_interface(USBDevice *dev, int iface, int old, int value)
+{
+    UACState *s = USB_UAC(dev);
+
+    DBG(s, "set_interface if=%d alt=%d\n", iface, value);
+    if (iface == 1) {
+        s->out_alt = value;
+        s->fifo.prod = s->fifo.cons = 0;
+        AUD_set_active_out(s->vout, value != 0);
+    } else if (iface == 2) {
+        s->in_alt = value;
+        s->in_acc = 0;
+    }
+    report(s, true);
+}
+
+static void uac_handle_reset(USBDevice *dev)
+{
+    UACState *s = USB_UAC(dev);
+
+    s->out_alt = s->in_alt = 0;
+    if (s->vout) {
+        AUD_set_active_out(s->vout, false);
+    }
+}
+
+static void uac_unrealize(USBDevice *dev)
+{
+    UACState *s = USB_UAC(dev);
+
+    report(s, true);
+    AUD_close_out(&s->card, s->vout);
+    AUD_remove_card(&s->card);
+    g_free(s->fifo.data);
+}
+
+static void uac_realize(USBDevice *dev, Error **errp)
+{
+    UACState *s = USB_UAC(dev);
+    int i;
+
+    if (s->version != 1 && s->version != 2) {
+        error_setg(errp, "uac must be 1 or 2");
+        return;
+    }
+    if (s->version == 1) {
+        s->hs = false;
+    }
+    if (s->implicit) {
+        s->feedback = false;        /* asynchronous, paced by the capture stream */
+    }
+    if (s->hsint < 1 || s->hsint > 4) {
+        s->hsint = 1;
+    }
+    if (!(s->ratemask & 7)) {
+        s->ratemask = 7;
+    }
+    if (!AUD_register_card(TYPE_USB_UAC, &s->card, errp)) {
+        return;
+    }
+    build_desc(s);
+    dev->usb_desc = &s->desc;
+    usb_desc_create_serial(dev);
+    usb_desc_init(dev);
+    s->rate_out = s->rate_in = (s->ratemask & 2) ? 48000 : uac_rates[ctz32(s->ratemask)];
+    for (i = 0; i < 8; i++) {
+        s->mute[i] = (i == 0 || i == 4);    /* like many real devices: muted until told */
+        s->vol[i] = (int16_t)0xE200;        /* -30 dB */
+    }
+    s->min_pkt = 0xFFFF;
+    open_voice(s);
+    DBG(s, "uac%u %s speed, capture %d, feedback %d (%d ppm), rates %x\n", s->version,
+        s->hs ? "high" : "full", s->capture, s->feedback, s->fbppm, s->ratemask);
+}
+
+static const VMStateDescription vmstate_uac = {
+    .name = TYPE_USB_UAC,
+    .unmigratable = 1,
+};
+
+static Property uac_properties[] = {
+    DEFINE_AUDIO_PROPERTIES(UACState, card),
+    DEFINE_PROP_UINT32("uac", UACState, version, 2),
+    DEFINE_PROP_BOOL("hs", UACState, hs, true),
+    DEFINE_PROP_BOOL("capture", UACState, capture, true),
+    DEFINE_PROP_BOOL("feedback", UACState, feedback, true),
+    DEFINE_PROP_INT32("fbppm", UACState, fbppm, 0),
+    DEFINE_PROP_UINT32("ratemask", UACState, ratemask, 7),
+    DEFINE_PROP_UINT32("hsint", UACState, hsint, 1),
+    DEFINE_PROP_UINT32("debug", UACState, debug, 0),
+    DEFINE_PROP_BOOL("midi", UACState, midi, false),
+    DEFINE_PROP_BOOL("implicit", UACState, implicit, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void uac_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    USBDeviceClass *k = USB_DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_uac;
+    device_class_set_props(dc, uac_properties);
+    set_bit(DEVICE_CATEGORY_SOUND, dc->categories);
+    k->product_desc = "QEMU USB Audio Class test device";
+    k->realize = uac_realize;
+    k->handle_reset = uac_handle_reset;
+    k->handle_attach = usb_desc_attach;
+    k->handle_control = uac_handle_control;
+    k->handle_data = uac_handle_data;
+    k->unrealize = uac_unrealize;
+    k->set_interface = uac_set_interface;
+}
+
+static const TypeInfo uac_info = {
+    .name = TYPE_USB_UAC,
+    .parent = TYPE_USB_DEVICE,
+    .instance_size = sizeof(UACState),
+    .class_init = uac_class_init,
+};
+
+static void uac_register_types(void)
+{
+    type_register_static(&uac_info);
+}
+
+type_init(uac_register_types)
diff --git a/hw/usb/dev-uvc.c b/hw/usb/dev-uvc.c
new file mode 100644
