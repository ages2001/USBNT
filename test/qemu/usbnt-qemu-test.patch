@@ -1743,8 +1743,56 @@ static int ehci_state_fetchsitd(EHCIState *ehci, int async)
     if (!(sitd.results & SITD_RESULTS_ACTIVE)) {
         /* siTD is not active, nothing to do */;
     } else {
-        /* TODO: split transfers are not implemented */
-        warn_report("Skipping active siTD");
+        /* split isochronous transfer, executed directly on the full speed
+           device (no transaction translator timing) */
+        uint32_t len = (sitd.results & SITD_RESULTS_TBYTES_MASK) >> 16;
+        uint32_t dir = (sitd.epchar & SITD_EPCHAR_IO) ? 1 : 0;
+        uint32_t devaddr = sitd.epchar & SITD_EPCHAR_DEVADDR_MASK;
+        uint32_t endp = (sitd.epchar & SITD_EPCHAR_EPNUM_MASK) >> SITD_EPCHAR_EPNUM_SH;
+        uint32_t off = sitd.bufptr[0] & SITD_BUFPTR_CURROFF_MASK;
