diff --git a/hw/i2c/smbus_fch.c b/hw/i2c/smbus_fch.c
new file mode 100644
index 0000000..b5b3465
--- /dev/null
+++ b/hw/i2c/smbus_fch.c
@@ -0,0 +1,256 @@
+/*
+ * smbus_fch.c - the SMBus host of an AMD FCH ("KERNCZ", PCI 1022:790B) for
+ * the USBNT tests, as Linux drivers/i2c/busses/i2c-piix4.c drives it.
+ *
+ *   -device amd-fch-smbus,addr=14.0[,rev=0x59]
+ *
+ * Power management registers: indexed I/O at 0CD6h / 0CD7h and, from
+ * revision 51h on, memory at FED80300h.  PM 00h bit 4 = SMBus on, PM 01h =
+ * I/O base 15:8 (revisions 49h and later); PM 2Ch / 2Dh = base and enable bit
+ * (older); PM 02h bits 4:3 = the port of the multiplexed main SMBus.  Two
+ * ports with an I2C bus each: "fchsmb0", "fchsmb1".
+ *
+ * SMBus registers at 0B00h with PIIX4 semantics: a transfer runs at the start
+ * bit, status 01h busy, 02h done, 04h no answer; block data through DAT0 (the
+ * count) and BLKDAT (reading HSTCNT puts its index to 0).  SMBSLVCNT (08h)
+ * bit 4 = the host semaphore (written 1: taken when free), bit 5 written 1 =
+ * given back.
+ *
+ * QOM read-outs: transactions, bad (a transfer without the semaphore, the
+ * semaphore given back with another port selected than before it was taken),
+ * port (the current selection).
+ */
+#include "qemu/osdep.h"
+#include "hw/pci/pci_device.h"
+#include "hw/i2c/i2c.h"
+#include "hw/i2c/smbus_master.h"
+#include "hw/qdev-properties.h"
+#include "exec/address-spaces.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_AMD_FCH_SMBUS "amd-fch-smbus"
+OBJECT_DECLARE_SIMPLE_TYPE(FchSmbus, AMD_FCH_SMBUS)
+
+#define SMB_BASE    0x0B00
+
+struct FchSmbus {
+    PCIDevice parent;
+    uint8_t rev;
+    uint8_t pm[256];
+    uint8_t pm_idx;
+    MemoryRegion pm_io, pm_mem, smb_io;
+    I2CBus *bus[2];
+    uint8_t sts, cnt, cmd, add, dat0, dat1, blk[32], idx;
+    uint8_t own, own_port;
+    uint32_t transactions, bad, port;
+};
+
+static uint64_t pm_io_read(void *opaque, hwaddr a, unsigned size)
+{
+    FchSmbus *s = opaque;
+    return a == 0 ? s->pm_idx : s->pm[s->pm_idx];
+}
+
+static void pm_io_write(void *opaque, hwaddr a, uint64_t v, unsigned size)
+{
+    FchSmbus *s = opaque;
+    if (a == 0) {
+        s->pm_idx = v;
+    } else {
+        s->pm[s->pm_idx] = v;
+    }
+    s->port = (s->pm[0x02] >> 3) & 3;
+}
+
+static const MemoryRegionOps pm_io_ops = {
+    .read = pm_io_read,
+    .write = pm_io_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 1,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static uint64_t pm_mem_read(void *opaque, hwaddr a, unsigned size)
+{
+    FchSmbus *s = opaque;
+    return s->pm[a & 0xFF];
+}
+
+static void pm_mem_write(void *opaque, hwaddr a, uint64_t v, unsigned size)
+{
+    FchSmbus *s = opaque;
+    s->pm[a & 0xFF] = v;
+    s->port = (s->pm[0x02] >> 3) & 3;
+}
+
+static const MemoryRegionOps pm_mem_ops = {
+    .read = pm_mem_read,
+    .write = pm_mem_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 1,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void transfer(FchSmbus *s)
+{
+    I2CBus *bus = s->bus[s->port & 1];
+    uint8_t addr = s->add >> 1, rd = s->add & 1, prot = (s->cnt >> 2) & 7;
+    int r = -1;
+
+    s->transactions++;
+    if (!s->own) {
+        s->bad++;
+    }
+    switch (prot) {
+    case 0:
+        r = smbus_quick_command(bus, addr, rd);
+        break;
+    case 1:
+        if (rd) {
+            r = smbus_receive_byte(bus, addr);
+            if (r >= 0) s->dat0 = r;
+        } else {
+            r = smbus_send_byte(bus, addr, s->cmd);
+        }
+        break;
+    case 2:
+        if (rd) {
+            r = smbus_read_byte(bus, addr, s->cmd);
+            if (r >= 0) s->dat0 = r;
+        } else {
+            r = smbus_write_byte(bus, addr, s->cmd, s->dat0);
+        }
+        break;
+    case 5:
+        if (rd) {
+            r = smbus_read_block(bus, addr, s->cmd, s->blk, sizeof(s->blk), true, true);
+            if (r > 0) s->dat0 = r; else r = -1;
+        } else {
+            r = smbus_write_block(bus, addr, s->cmd, s->blk, MIN(s->dat0, 32), true);
+        }
+        break;
+    default:
+        break;
+    }
+    s->idx = 0;
+    s->sts = r < 0 ? 0x04 : 0x02;
+}
+
+static uint64_t smb_read(void *opaque, hwaddr a, unsigned size)
+{
+    FchSmbus *s = opaque;
+
+    switch (a) {
+    case 0: return s->sts;
+    case 2: s->idx = 0; return s->cnt & 0x1F;
+    case 3: return s->cmd;
+    case 4: return s->add;
+    case 5: return s->dat0;
+    case 6: return s->dat1;
+    case 7: return s->blk[s->idx++ & 31];
+    case 8: return s->own ? 0x10 : 0x00;
+    default: return 0;
+    }
+}
+
+static void smb_write(void *opaque, hwaddr a, uint64_t v, unsigned size)
+{
+    FchSmbus *s = opaque;
+
+    switch (a) {
+    case 0: s->sts &= ~v; break;
+    case 2:
+        s->cnt = v & ~0x40;
+        if (v & 0x40) transfer(s);
+        break;
+    case 3: s->cmd = v; break;
+    case 4: s->add = v; break;
+    case 5: s->dat0 = v; break;
+    case 6: s->dat1 = v; break;
+    case 7: s->blk[s->idx++ & 31] = v; break;
+    case 8:
+        if ((v & 0x10) && !s->own) {
+            s->own = 1;
+            s->own_port = s->port;
+        }
+        if ((v & 0x20) && s->own) {
+            if (s->port != s->own_port) {
+                s->bad++;                       /* the port must be put back */
+            }
+            s->own = 0;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps smb_ops = {
+    .read = smb_read,
+    .write = smb_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 1,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void fch_realize(PCIDevice *pd, Error **errp)
+{
+    FchSmbus *s = AMD_FCH_SMBUS(pd);
+
+    pci_config_set_revision(pd->config, s->rev);
+    memset(s->pm, 0, sizeof(s->pm));
+    s->pm[0x00] = 0x10;                         /* SMBus on (49h and later) */
+    s->pm[0x01] = SMB_BASE >> 8;
+    s->pm[0x2C] = (SMB_BASE & 0xE0) | 0x01;     /* older revisions */
+    s->pm[0x2D] = SMB_BASE >> 8;
+    s->bus[0] = i2c_init_bus(DEVICE(pd), "fchsmb0");
+    s->bus[1] = i2c_init_bus(DEVICE(pd), "fchsmb1");
+    memory_region_init_io(&s->pm_io, OBJECT(pd), &pm_io_ops, s, "fch-pm-idx", 2);
+    memory_region_add_subregion(pci_address_space_io(pd), 0xCD6, &s->pm_io);
+    memory_region_init_io(&s->smb_io, OBJECT(pd), &smb_ops, s, "fch-smbus", 16);
+    memory_region_add_subregion(pci_address_space_io(pd), SMB_BASE, &s->smb_io);
+    if (s->rev >= 0x51) {
+        memory_region_init_io(&s->pm_mem, OBJECT(pd), &pm_mem_ops, s, "fch-pm", 0x100);
+        memory_region_add_subregion(get_system_memory(), 0xFED80300, &s->pm_mem);
+    }
+}
+
+static Property fch_props[] = {
+    DEFINE_PROP_UINT8("rev", FchSmbus, rev, 0x59),
+    DEFINE_PROP_UINT32("transactions", FchSmbus, transactions, 0),
+    DEFINE_PROP_UINT32("bad", FchSmbus, bad, 0),
+    DEFINE_PROP_UINT32("port", FchSmbus, port, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void fch_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    k->realize = fch_realize;
+    k->vendor_id = 0x1022;
+    k->device_id = 0x790B;
+    k->class_id = 0x0C05;
+    device_class_set_props(dc, fch_props);
+    dc->desc = "AMD FCH SMBus host (test device)";
+}
+
+static const TypeInfo fch_info = {
+    .name = TYPE_AMD_FCH_SMBUS,
+    .parent = TYPE_PCI_DEVICE,
+    .instance_size = sizeof(FchSmbus),
+    .class_init = fch_class_init,
+    .interfaces = (InterfaceInfo[]) {
+        { INTERFACE_CONVENTIONAL_PCI_DEVICE },
+        { },
+    },
+};
+
+static void fch_register_types(void)
+{
+    type_register_static(&fch_info);
+}
+
+type_init(fch_register_types)
