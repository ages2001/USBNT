#include <windows.h>
#include "usbntver.h"

1 VERSIONINFO
FILEVERSION USBNT_VERSION_NUM
PRODUCTVERSION USBNT_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE USBNT_FILE_TYPE
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ages2001\0"
            VALUE "FileDescription", USBNT_FILE_DESCRIPTION "\0"
            VALUE "FileVersion", USBNT_VERSION_FULL "\0"
            VALUE "OriginalFilename", USBNT_FILE_NAME "\0"
            VALUE "ProductName", "USBNT\0"
            VALUE "ProductVersion", USBNT_VERSION_FULL "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
