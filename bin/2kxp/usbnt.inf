[USBNT_HC.NT]
CopyFiles = USBNT_Files

[USBNT_HC.NT.Services]
AddService = usbnt, 0x00000002, USBNT_Service

[USBNT_Bus.NT]
CopyFiles = USBNT_Files

[USBNT_Bus.NT.Services]
AddService = usbnt, 0x00000002, USBNT_Service

[USBNT_HCX.NT]
Include = usbport.inf
CopyFiles = USBNT_Files, HUB20.CopyFiles.NT

[USBNT_HCX.NT.Services]
AddService = usbnt, 0x00000002, USBNT_Service

[USBNT_BusX.NT]
Include = usbport.inf
CopyFiles = USBNT_Files, HUB20.CopyFiles.NT

[USBNT_BusX.NT.Services]
AddService = usbnt, 0x00000002, USBNT_Service

[USBNT_Service]
DisplayName    = %SvcDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1
ServiceBinary  = %12%\usbnt.sys
LoadOrderGroup = SCSI miniport
AddReg         = USBNT_Params

[USBNT_Params]
HKR,Parameters,DebugLevel,0x00010003,2

[USBNT_Files]
usbnt.sys

[Strings]
USBNT = "USBNT"
Disk = "USBNT disk"
SvcDesc = "USBNT USB driver"
xhci.Desc = "USBNT USB 3.x eXtensible Host Controller"
usbhc.Desc = "USBNT USB Host Controller"
usb4.Desc = "USBNT USB4 Host Router"
tbt.Desc = "USBNT Thunderbolt 3 / 4 Host Router"
sdhci.Desc = "USBNT SD Card Reader (SDHCI)"
rtsx.Desc = "USBNT SD Card Reader (Realtek PCIe)"
i2c.Desc = "USBNT HID over I2C Controller (touch pad, touch screen)"
bus.Desc = "USBNT Device Bus (USB keyboards, mice, disks, UAS)"
hub.Desc = "USBNT USB Hub"
node.Desc = "USBNT USB Device"
